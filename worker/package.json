{
  "name": "newline-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Newline's Cloudflare Worker: Google sign-in sessions, the notes store and the media store",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --strict-vars=false",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply newline --local",
    "migrate:remote": "wrangler d1 migrations apply newline --remote"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  }
}
