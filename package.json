{
  "name": "newline",
  "productName": "Newline",
  "version": "0.1.0",
  "description": "A local-first rich text note editor",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/dev-app-name.mjs && node scripts/build-native.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-native.mjs",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "release:mac": "npm run build && electron-builder --mac --publish always",
    "release:win": "npm run build && electron-builder --win --publish always",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.3",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-autolink-literal": "^2.1.2",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-task-list-item": "^2.0.1",
    "mdast-util-mdx-jsx": "^3.2.2",
    "mdast-util-to-markdown": "^2.2.4",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "micromark-extension-mdx-md": "^2.0.0",
    "node-llama-cpp": "^3.22.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.2",
    "prosemirror-inputrules": "^1.7.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.7",
    "prosemirror-view": "^1.43.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-window": "^2.2.7",
    "uuid": "^13.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.1"
  }
}
